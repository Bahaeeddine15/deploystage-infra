# Terraform local state — contains sensitive values (e.g. ACR admin password) in plaintext.
# Never commit this. Later we'll move to a remote backend so state isn't just local files.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform working directory — downloaded provider plugins, re-generated by `terraform init`.
.terraform/

# Crash log files, if Terraform ever produces one.
crash.log
crash.*.log

# Variable files that may contain secrets (e.g. terraform.tfvars with real credentials).
# Keep .tfvars.example checked in instead, without real values.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files, used for local-only tweaks that shouldn't be shared.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config that may include auth info.
.terraformrc
terraform.rc